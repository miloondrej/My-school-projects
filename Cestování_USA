# 1. ČÁST: KALKULAČKA (Přepočet peněz)
print("=== VÍTEJ V CESTOVATELSKÉM PLÁNOVAČI PRO USA ===")

koruny = int(input("Kolik máš naspořeno Kč na kapesné? "))
operace = str(input("Chceš peníze převést na Dolary ($) nebo Eura (€)? Napiš D nebo E: "))

if operace == "D":
    vysledek = koruny / 23  # Přibližný kurz dolaru
    print("Na cestu budeš mít v přepočtu:", vysledek, "dolarů.")
elif operace == "E":
    vysledek = koruny / 25  # Přibližný kurz eura
    print("Na cestu budeš mít v přepočtu:", vysledek, "eur.")
else:
    print("Tuto měnu neznám, bereme to tak, že máš 0 dolarů.")
    vysledek = 0

print("--------------------------------------------------")

